<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/step_read_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_m"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/step_read_number"
        android:layout_width="@dimen/step_bullet"
        android:layout_height="@dimen/step_bullet"
        android:background="@drawable/bg_step_number"
        android:gravity="center"
        android:textColor="@color/page_cream"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/step_read_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_m"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.App.Body" />

</LinearLayout>
