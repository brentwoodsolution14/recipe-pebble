<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/step_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_m"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/step_number"
        android:layout_width="@dimen/step_bullet"
        android:layout_height="@dimen/step_bullet"
        android:background="@drawable/bg_step_number"
        android:gravity="center"
        android:textColor="@color/page_cream"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/step_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_m"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.App.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/step_up"
        style="@style/Widget.App.Button.IconOnly"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/cd_move_up"
        app:icon="@drawable/ic_arrow_up" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/step_down"
        style="@style/Widget.App.Button.IconOnly"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/cd_move_down"
        app:icon="@drawable/ic_arrow_down" />

</LinearLayout>
