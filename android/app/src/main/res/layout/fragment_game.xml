<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_cream">

    <ImageView
        android:id="@+id/game_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.12"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_editor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/game_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/header_height_game"
        android:background="@drawable/bg_header_paper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_back_icon"
            style="@style/Widget.App.Button.IconOnly"
            android:layout_marginStart="@dimen/gap_s"
            android:contentDescription="@string/cd_back"
            app:icon="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/game_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/game_title"
            android:textAppearance="@style/TextAppearance.App.Title"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/game_stage_caption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/game_stage_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/game_stage_one"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/game_title" />

        <LinearLayout
            android:id="@+id/game_progress_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/screen_margin_small"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/game_seg_one"
                android:layout_width="@dimen/seg_width"
                android:layout_height="@dimen/seg_height"
                android:background="@drawable/bg_seg_on" />

            <View
                android:id="@+id/game_seg_two"
                android:layout_width="@dimen/seg_width"
                android:layout_height="@dimen/seg_height"
                android:layout_marginStart="@dimen/gap_xs"
                android:background="@drawable/bg_seg_off" />

            <View
                android:id="@+id/game_seg_three"
                android:layout_width="@dimen/seg_width"
                android:layout_height="@dimen/seg_height"
                android:layout_marginStart="@dimen/gap_xs"
                android:background="@drawable/bg_seg_off" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/game_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/gap_l"
        app:layout_constraintBottom_toTopOf="@id/game_warning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_header">

        <LinearLayout
            android:id="@+id/game_stage_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/gap_l"
            android:paddingEnd="@dimen/screen_margin">

            <LinearLayout
                android:id="@+id/stage_one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.recipepebble.book.core.ui.SectionHeaderView
                    android:id="@+id/stage_one_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/game_name_field"
                    style="@style/Widget.App.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_l"
                    android:hint="@string/game_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/game_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/game_minutes_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_xl"
                    android:text="@string/game_minutes_label"
                    android:textAppearance="@style/TextAppearance.App.Label" />

                <LinearLayout
                    android:id="@+id/game_minutes_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:background="@drawable/bg_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/game_minutes_minus"
                        style="@style/Widget.App.Button.IconOnly"
                        android:contentDescription="@string/cd_minutes_down"
                        app:icon="@drawable/ic_minus" />

                    <TextView
                        android:id="@+id/game_minutes_value"
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:text="@string/settings_default_time_value"
                        android:textAppearance="@style/TextAppearance.App.Stat"
                        android:textColor="@color/terracotta" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/game_minutes_plus"
                        style="@style/Widget.App.Button.IconOnly"
                        android:contentDescription="@string/cd_minutes_up"
                        app:icon="@drawable/ic_plus"
                        app:iconTint="@color/ink" />

                </LinearLayout>

                <TextView
                    android:id="@+id/game_tags_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_xl"
                    android:text="@string/game_tags_label"
                    android:textAppearance="@style/TextAppearance.App.Label" />

                <LinearLayout
                    android:id="@+id/game_tag_row_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:orientation="horizontal">

                    <com.recipepebble.book.core.ui.TagChipView
                        android:id="@+id/tag_one"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1" />

                    <com.recipepebble.book.core.ui.TagChipView
                        android:id="@+id/tag_two"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/gap_s"
                        android:layout_weight="1" />

                    <com.recipepebble.book.core.ui.TagChipView
                        android:id="@+id/tag_three"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/gap_s"
                        android:layout_weight="1" />

                    <com.recipepebble.book.core.ui.TagChipView
                        android:id="@+id/tag_four"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/gap_s"
                        android:layout_weight="1" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/game_tag_row_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:orientation="horizontal">

                    <com.recipepebble.book.core.ui.TagChipView
                        android:id="@+id/tag_five"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1" />

                    <com.recipepebble.book.core.ui.TagChipView
                        android:id="@+id/tag_six"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/gap_s"
                        android:layout_weight="1" />

                    <com.recipepebble.book.core.ui.TagChipView
                        android:id="@+id/tag_seven"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/gap_s"
                        android:layout_weight="1" />

                    <com.recipepebble.book.core.ui.TagChipView
                        android:id="@+id/tag_eight"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="@dimen/gap_s"
                        android:layout_weight="1" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/stage_two"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.recipepebble.book.core.ui.SectionHeaderView
                    android:id="@+id/stage_two_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_ingredient_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/game_ingredient_field"
                    style="@style/Widget.App.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:hint="@string/game_ingredient_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/game_ingredient_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/game_amount_field"
                    style="@style/Widget.App.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:hint="@string/game_amount_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/game_amount_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_add_ingredient"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/gap_m"
                    android:text="@string/game_add"
                    app:icon="@drawable/ic_plus"
                    app:iconTint="@color/ink_muted" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/stage_three"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.recipepebble.book.core.ui.SectionHeaderView
                    android:id="@+id/stage_three_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/game_step_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/game_step_field"
                    style="@style/Widget.App.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:hint="@string/game_step_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/game_step_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/game_add_step"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/gap_m"
                    android:text="@string/game_add_step"
                    app:icon="@drawable/ic_plus"
                    app:iconTint="@color/ink_muted" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/game_warning"
        android:layout_width="0dp"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/gap_s"
        android:background="@drawable/bg_warning_bar"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/gap_m"
        android:paddingEnd="@dimen/gap_m"
        android:text="@string/game_warning_ingredients"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/terracotta_dark"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/game_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/game_controls"
        android:layout_width="0dp"
        android:layout_height="@dimen/controls_sheet_game"
        android:background="@drawable/bg_controls_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/game_primary"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/screen_margin_small"
            android:layout_marginEnd="@dimen/screen_margin_small"
            android:layout_marginBottom="@dimen/cta_margin_bottom_game"
            android:text="@string/game_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/game_saving"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/page_cream"
            app:indicatorSize="20dp"
            app:layout_constraintBottom_toBottomOf="@id/game_primary"
            app:layout_constraintEnd_toEndOf="@id/game_primary"
            app:layout_constraintStart_toStartOf="@id/game_primary"
            app:layout_constraintTop_toTopOf="@id/game_primary"
            app:trackThickness="2dp" />

        <TextView
            android:id="@+id/game_summary"
            android:layout_width="0dp"
            android:layout_height="@dimen/summary_strip"
            android:layout_marginStart="@dimen/screen_margin_small"
            android:layout_marginEnd="@dimen/screen_margin_small"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/game_summary"
            android:textAppearance="@style/TextAppearance.App.Label"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/game_secondary_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/game_secondary_row"
            android:layout_width="0dp"
            android:layout_height="@dimen/secondary_height"
            android:layout_marginStart="@dimen/screen_margin_small"
            android:layout_marginEnd="@dimen/screen_margin_small"
            android:layout_marginBottom="@dimen/gap_xl"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_back"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/game_back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_draft"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/gap_m"
                android:layout_weight="1"
                android:text="@string/game_draft"
                android:textColor="@color/teal" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
