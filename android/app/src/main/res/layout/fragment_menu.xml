<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_cream">

    <ImageView
        android:id="@+id/menu_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.16"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_library"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/menu_brand"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/header_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:gravity="center_vertical"
        android:letterSpacing="0.18"
        android:text="@string/menu_brand"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="@color/ink_muted"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_settings"
        style="@style/Widget.App.Button.IconOnly"
        android:layout_marginEnd="@dimen/screen_margin_small"
        android:contentDescription="@string/cd_settings"
        app:icon="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="@id/menu_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/menu_brand" />

    <View
        android:id="@+id/menu_header_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline"
        android:background="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_brand" />

    <TextView
        android:id="@+id/menu_hero_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/gap_xl"
        android:text="@string/menu_hero_first"
        android:textAppearance="@style/TextAppearance.App.Hero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_header_divider" />

    <TextView
        android:id="@+id/menu_hero_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:text="@string/menu_hero_second"
        android:textAppearance="@style/TextAppearance.App.Hero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_hero_first" />

    <View
        android:id="@+id/menu_rule"
        android:layout_width="@dimen/rule_width"
        android:layout_height="@dimen/rule_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/gap_m"
        android:background="@drawable/bg_rule_terracotta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_hero_second" />

    <TextView
        android:id="@+id/menu_counts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/gap_m"
        android:accessibilityLiveRegion="polite"
        android:text="@string/menu_counts"
        android:textAppearance="@style/TextAppearance.App.Caption"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_rule" />

    <ImageView
        android:id="@+id/menu_hero_art"
        android:layout_width="@dimen/hero_sprite"
        android:layout_height="@dimen/hero_sprite"
        android:layout_marginEnd="@dimen/screen_margin_small"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_bowl"
        app:layout_constraintBottom_toBottomOf="@id/menu_counts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/menu_hero_first" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_filter_all"
        style="@style/Widget.App.Button.Chip"
        android:layout_width="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/gap_l"
        android:text="@string/menu_filter_all"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_counts" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_filter_favourites"
        style="@style/Widget.App.Button.Chip"
        android:layout_width="wrap_content"
        android:layout_marginStart="@dimen/gap_s"
        android:text="@string/menu_filter_favourites"
        app:layout_constraintBottom_toBottomOf="@id/menu_filter_all"
        app:layout_constraintStart_toEndOf="@id/menu_filter_all"
        app:layout_constraintTop_toTopOf="@id/menu_filter_all" />

    <LinearLayout
        android:id="@+id/menu_stats_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/gap_l"
        android:layout_marginEnd="@dimen/screen_margin"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_filter_all">

        <com.recipepebble.book.core.ui.StatCardView
            android:id="@+id/stat_recipes"
            android:layout_width="0dp"
            android:layout_height="@dimen/stat_card_height"
            android:layout_weight="1" />

        <com.recipepebble.book.core.ui.StatCardView
            android:id="@+id/stat_favourites"
            android:layout_width="0dp"
            android:layout_height="@dimen/stat_card_height"
            android:layout_marginStart="10dp"
            android:layout_weight="1" />

        <com.recipepebble.book.core.ui.StatCardView
            android:id="@+id/stat_tags"
            android:layout_width="0dp"
            android:layout_height="@dimen/stat_card_height"
            android:layout_marginStart="10dp"
            android:layout_weight="1" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menu_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/gap_l"
        android:layout_marginEnd="@dimen/screen_margin"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/gap_m"
        app:layout_constraintBottom_toTopOf="@id/menu_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_stats_row" />

    <ImageView
        android:id="@+id/menu_empty_art"
        android:layout_width="@dimen/empty_sprite"
        android:layout_height="@dimen/empty_sprite"
        android:alpha="0.6"
        android:contentDescription="@string/cd_empty_art"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_notebook"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/menu_empty_title"
        app:layout_constraintEnd_toEndOf="@id/menu_list"
        app:layout_constraintStart_toStartOf="@id/menu_list"
        app:layout_constraintTop_toTopOf="@id/menu_list"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/menu_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_l"
        android:text="@string/menu_empty_title"
        android:textAppearance="@style/TextAppearance.App.Headline"
        android:textSize="20sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/menu_empty_body"
        app:layout_constraintEnd_toEndOf="@id/menu_list"
        app:layout_constraintStart_toStartOf="@id/menu_list"
        app:layout_constraintTop_toBottomOf="@id/menu_empty_art" />

    <TextView
        android:id="@+id/menu_empty_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_s"
        android:gravity="center"
        android:text="@string/menu_empty_body"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/menu_list"
        app:layout_constraintEnd_toEndOf="@id/menu_list"
        app:layout_constraintStart_toStartOf="@id/menu_list"
        app:layout_constraintTop_toBottomOf="@id/menu_empty_title" />

    <TextView
        android:id="@+id/menu_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/gap_s"
        android:text="@string/menu_hint"
        android:textAppearance="@style/TextAppearance.App.Label"
        app:layout_constraintBottom_toTopOf="@id/menu_cta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_cta"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/screen_margin_small"
        android:layout_marginEnd="@dimen/screen_margin_small"
        android:layout_marginBottom="@dimen/cta_margin_bottom"
        android:text="@string/menu_cta"
        app:icon="@drawable/ic_plus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
