<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/gap_l">

    <LinearLayout
        android:id="@+id/settings_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:padding="@dimen/gap_xl">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:textSize="18sp" />

        <View
            android:id="@+id/settings_rule"
            android:layout_width="@dimen/rule_width"
            android:layout_height="@dimen/rule_height"
            android:layout_marginTop="@dimen/gap_m"
            android:background="@drawable/bg_rule_terracotta" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_keep_awake"
            android:layout_width="match_parent"
            android:layout_height="@dimen/secondary_height"
            android:layout_marginTop="@dimen/gap_m"
            android:text="@string/settings_keep_awake"
            android:textAppearance="@style/TextAppearance.App.Body"
            app:thumbTint="@color/surface_white"
            app:trackTint="@color/teal" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_checklist_first"
            android:layout_width="match_parent"
            android:layout_height="@dimen/secondary_height"
            android:text="@string/settings_checklist_first"
            android:textAppearance="@style/TextAppearance.App.Body"
            app:thumbTint="@color/surface_white"
            app:trackTint="@color/teal" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/settings_larger_text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/secondary_height"
            android:text="@string/settings_larger_text"
            android:textAppearance="@style/TextAppearance.App.Body"
            app:thumbTint="@color/surface_white"
            app:trackTint="@color/teal" />

        <View
            android:id="@+id/settings_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:layout_marginTop="@dimen/gap_s"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/settings_time_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/secondary_height"
            android:layout_marginTop="@dimen/gap_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settings_time_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_default_time"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_time_minus"
                style="@style/Widget.App.Button.IconOnly"
                android:contentDescription="@string/cd_minutes_down"
                app:icon="@drawable/ic_minus" />

            <TextView
                android:id="@+id/settings_time_value"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/settings_default_time_value"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="@color/terracotta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_time_plus"
                style="@style/Widget.App.Button.IconOnly"
                android:contentDescription="@string/cd_minutes_up"
                app:icon="@drawable/ic_plus"
                app:iconTint="@color/ink" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_reset"
            style="@style/Widget.App.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/gap_l"
            android:text="@string/settings_reset"
            app:icon="@drawable/ic_trash" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_close"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/gap_s"
            android:text="@string/settings_close" />

    </LinearLayout>

</RelativeLayout>
