<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/gap_l">

    <LinearLayout
        android:id="@+id/confirm_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:padding="@dimen/gap_xl">

        <TextView
            android:id="@+id/confirm_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/confirm_title"
            android:textAppearance="@style/TextAppearance.App.Headline"
            android:textSize="18sp" />

        <View
            android:id="@+id/confirm_rule"
            android:layout_width="@dimen/rule_width"
            android:layout_height="@dimen/rule_height"
            android:layout_marginTop="@dimen/gap_m"
            android:background="@drawable/bg_rule_terracotta" />

        <TextView
            android:id="@+id/confirm_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:text="@string/confirm_reset_body"
            android:textAppearance="@style/TextAppearance.App.Body" />

        <LinearLayout
            android:id="@+id/confirm_row"
            android:layout_width="match_parent"
            android:layout_height="@dimen/secondary_height"
            android:layout_marginTop="@dimen/gap_xl"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_no"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/confirm_no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_yes"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/secondary_height"
                android:layout_marginStart="@dimen/gap_m"
                android:layout_weight="1"
                android:text="@string/confirm_yes" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
