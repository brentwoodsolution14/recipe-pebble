<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_cream">

    <ImageView
        android:id="@+id/detail_hero_image"
        android:layout_width="0dp"
        android:layout_height="@dimen/hero_band"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_editor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/detail_hero_scrim"
        android:layout_width="0dp"
        android:layout_height="@dimen/hero_band"
        android:background="@drawable/overlay_detail_scrim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/detail_back_icon"
        style="@style/Widget.App.Button.IconOnly"
        android:layout_marginStart="@dimen/gap_s"
        android:layout_marginTop="@dimen/gap_s"
        android:contentDescription="@string/cd_back"
        app:icon="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/detail_ribbon"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/gap_m"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/bg_ribbon_teal"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:paddingStart="@dimen/gap_l"
        android:paddingEnd="@dimen/gap_l"
        android:text="@string/detail_ribbon"
        android:textAppearance="@style/TextAppearance.App.Label"
        android:textColor="@color/page_cream"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/detail_thumb"
        android:layout_width="@dimen/detail_sprite"
        android:layout_height="@dimen/detail_sprite"
        android:layout_marginStart="@dimen/screen_margin"
        android:contentDescription="@string/cd_detail_thumb"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_cupcake"
        app:layout_constraintBottom_toBottomOf="@id/detail_hero_image"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/gap_l"
        app:layout_constraintBottom_toTopOf="@id/detail_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detail_hero_image">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/gap_l"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detail_title"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textSize="28sp" />

            <View
                android:id="@+id/detail_rule"
                android:layout_width="@dimen/rule_width"
                android:layout_height="@dimen/rule_height"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/bg_rule_terracotta" />

            <TextView
                android:id="@+id/detail_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:letterSpacing="0.08"
                android:text="@string/detail_meta"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/ink_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/detail_tag_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <com.recipepebble.book.core.ui.TagChipView
                    android:id="@+id/detail_tag_one"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height" />

                <com.recipepebble.book.core.ui.TagChipView
                    android:id="@+id/detail_tag_two"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginStart="@dimen/gap_s" />

                <com.recipepebble.book.core.ui.TagChipView
                    android:id="@+id/detail_tag_three"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/chip_height"
                    android:layout_marginStart="@dimen/gap_s" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_l"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.recipepebble.book.core.ui.StatCardView
                    android:id="@+id/detail_stat_minutes"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_weight="1" />

                <com.recipepebble.book.core.ui.StatCardView
                    android:id="@+id/detail_stat_items"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />

                <com.recipepebble.book.core.ui.StatCardView
                    android:id="@+id/detail_stat_steps"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/stat_card_height"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detail_ingredients_card"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/gap_l">

                    <com.recipepebble.book.core.ui.SectionHeaderView
                        android:id="@+id/detail_ingredients_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/detail_ingredients_host"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_s"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detail_steps_card"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/gap_l">

                    <com.recipepebble.book.core.ui.SectionHeaderView
                        android:id="@+id/detail_steps_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/detail_steps_host"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_s"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail_controls"
        android:layout_width="0dp"
        android:layout_height="@dimen/controls_sheet_detail"
        android:background="@drawable/bg_controls_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/detail_row_one"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/screen_margin_small"
            android:layout_marginTop="@dimen/gap_m"
            android:layout_marginEnd="@dimen/screen_margin_small"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_favourite"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1.6"
                android:text="@string/detail_favourite_add"
                app:icon="@drawable/ic_heart_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_delete"
                style="@style/Widget.App.Button.Destructive"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/gap_m"
                android:layout_weight="1"
                android:text="@string/detail_delete"
                app:icon="@drawable/ic_trash" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/detail_row_two"
            android:layout_width="0dp"
            android:layout_height="@dimen/secondary_height"
            android:layout_marginStart="@dimen/screen_margin_small"
            android:layout_marginEnd="@dimen/screen_margin_small"
            android:layout_marginBottom="@dimen/gap_xl"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_again"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/secondary_height"
                android:layout_weight="1.7"
                android:text="@string/detail_again" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_menu"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/secondary_height"
                android:layout_marginStart="@dimen/gap_m"
                android:layout_weight="1"
                android:text="@string/detail_menu" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
